DATABASE_URL=sakuravel:password@tcp(localhost:3306)/sakuravel?parseTime=true&charset=utf8mb4
PORT=8080
# コネクションプール設定。VM 1 台あたりの上限なので、総接続数は
# DB_MAX_OPEN_CONNS x VM 台数 になる。DB の max_connections を超えると新規接続が全滅する。
# 例: max_connections=151 で VM 5 台なら 10 x 5 = 50 で収まる。13 台を超えるなら本値を下げる。
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5

# 通知バス。既定のままで動く。INTERVAL は「どれくらいの頻度で」、BATCH は「1 回で何件まで」、
# RETENTION は「何秒ぶん残すか」で、それぞれ効く先が違う。

# 中継表を見に行く間隔。配信の速さに直結するが、詰めるほど DB への問い合わせが増える。
NOTIFY_POLL_INTERVAL_MS=250
# 1 回の問い合わせで読む上限。定常時は関係なく、溜まった分を取り戻す速さだけに効く。
NOTIFY_POLL_BATCH=200

# 古い行の掃除を試みる間隔。ロックを取れた 1 プロセスだけが実際に削除する。
NOTIFY_GC_INTERVAL_SEC=60
# 1 回の DELETE で消す上限。大きいほど掃除は速いが、ロック保持と undo log が膨らむ。
NOTIFY_GC_BATCH=1000
# 中継表に行を残す秒数。配信済みでもこの間は消さない。
# 短くしすぎると、停止していたプロセスが復帰したときに読む前に消える。
NOTIFY_RETENTION_SEC=3600

# compose が publish するホスト側ポート。既に埋まっている場合はここで退避する。
# 公開されるのは proxy(nginx) の 1 ポートのみ（api / db / frontend は内部のみ）。
# 例: PROXY_HOST_PORT=8000 docker compose up -d
PROXY_HOST_PORT=80

# コンテナレジストリのホスト名。未設定ならリポジトリ既定のプレースホルダのままになる。
REGISTRY_HOST=
