# 単一オリジンの入口。/api を api へ、それ以外を frontend へ振り分ける。
# 上流は AppRun ワーカーノードへの直接続(ホストNW共有のため <ノードIP>:<port> で届く)。
# 以前の LB:80 + internal ラベル折り返しは廃止 — LB:80 への Host ヘッダ偽装で外部から
# 内部アプリへ到達できる穴を塞ぐため(80 番自体は Let's Encrypt 検証用に開けたまま)。
# ローカル(docker compose)では上流1台をサービス名で指定する:
#   API_UPSTREAM_SERVERS="server api:8080;" / FRONT_UPSTREAM_SERVERS="server frontend:3000;"
# 環境変数: API_UPSTREAM_SERVERS / FRONT_UPSTREAM_SERVERS(nginx の server 行をそのまま並べる)

upstream api_backend {
    ${API_UPSTREAM_SERVERS}
}

upstream front_backend {
    ${FRONT_UPSTREAM_SERVERS}
}

server {
    # AppRun はホストのネットワーク名前空間でコンテナを実行するため、
    # ポートはクラスタ内の全アプリで一意にする必要がある（api=8080 / frontend=3000 と重複不可）
    listen 8081;

    # ヘルスチェック用（上流には依存しない）
    location = /nginx-healthz {
        return 200 "ok\n";
    }

    # 例外: /api/config は frontend 自身のルート（ブラウザに API_URL を伝える設定エンドポイント）
    location = /api/config {
        proxy_pass http://front_backend;
        proxy_set_header Host $host;
        # 未割当ノード IP を素早く見切る（upstream の max_fails と併せて切り離す）
        proxy_connect_timeout 500ms;
    }

    # API（/api プレフィックスを剥がして転送）
    location /api/ {
        proxy_pass http://api_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 500ms;

        # SSE（/api/notifications/stream, /api/posts/:id/thread/stream）対策
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # frontend
    location / {
        proxy_pass http://front_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 500ms;
    }
}
