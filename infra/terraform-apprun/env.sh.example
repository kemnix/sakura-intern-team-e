# Terraform 実行用の秘密情報（ローカル用）
#
# 使い方:
#   cp env.sh.example env.sh   # env.sh は gitignore 済み
#   （env.sh に実際の値を記入）
#   source env.sh
#   terraform plan -var-file=dev.tfvars
#
# ここに書く値はすべて GitHub Secrets にも同じものを登録する（CI 用）。
# 対応: SAKURA_ACCESS_TOKEN(_SECRET) / DB_PASSWORD / BASTION_PASSWORD / REGISTRY_PASSWORD
# ※オブジェクトストレージの鍵だけは ~/.aws/credentials の [sakura] プロファイルに書く（terraform.tf 参照）

# さくらのクラウド APIキー（コンパネ右上 → APIキー）
export SAKURA_ACCESS_TOKEN=""
export SAKURA_ACCESS_TOKEN_SECRET=""

# S3互換ストレージ(tfstate)対策の保険: AWS SDK の整合性チェックを「必要な場合のみ」に抑える。
# terraform の skip_s3_checksum はアップロード側しかカバーしない(hashicorp/terraform#37432)
export AWS_REQUEST_CHECKSUM_CALCULATION="when_required"
export AWS_RESPONSE_CHECKSUM_VALIDATION="when_required"

# DBアプライアンスのパスワード（1Password のチーム共有値）
export TF_VAR_db_password=""

# 踏み台サーバーの初期パスワード（新規生成して 1Password へ）
export TF_VAR_bastion_password=""

# コンテナレジストリ（intern-team-e.sakuracr.jp）ユーザーのパスワード
export TF_VAR_registry_password=""

# 手動 push 用レジストリユーザー（dev-push-user）のパスワード
# 空のままならこのユーザーは作成されない。CI 用には GitHub Secrets の REGISTRY_DEV_PASSWORD
export TF_VAR_registry_dev_password=""

# （任意）ダウン検知の通知先 Webhook。未設定なら通知なし。
# Slack: https://hooks.slack.com/services/... / Discord: Webhook URL の末尾に /slack を付ける
# CI 用には同じ値を GitHub Secrets の ALERT_WEBHOOK に登録する
export TF_VAR_alert_slack_webhook=""
